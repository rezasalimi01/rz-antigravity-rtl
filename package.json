{
  "name": "rz-antigravity-rtl",
  "version": "1.1.5",
  "description": "Smart RTL patcher with UI settings for Antigravity Desktop and Antigravity IDE.",
  "main": "./bin/index.js",
  "scripts": {
    "test": "echo \"Error: no test specified\" && exit 1",
    "sync-version": "node bin/index.js --help > /dev/null 2>&1 || true",
    "version": "node -e \"const fs=require('fs'),path=require('path'),pkg=require('./package.json');const b='class=\\\"rtl-version-badge\\\">v'+pkg.version+'<';['payload.js','ide-payload.js'].forEach(f=>{const p=path.join(__dirname,'bin',f);if(fs.existsSync(p)){let c=fs.readFileSync(p,'utf8');fs.writeFileSync(p,c.replace(/class=\\\"rtl-version-badge\\\">v[^<]*</g,b),'utf8');}});\" && git add bin/payload.js bin/ide-payload.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rezasalimi01/rz-antigravity-rtl.git"
  },
  "homepage": "https://github.com/rezasalimi01/rz-antigravity-rtl#readme",
  "bugs": {
    "url": "https://github.com/rezasalimi01/rz-antigravity-rtl/issues"
  },
  "keywords": [
    "antigravity",
    "antigravity-ide",
    "rtl",
    "persian",
    "arabic",
    "hebrew",
    "patcher",
    "electron",
    "asar",
    "monaco-editor"
  ],
  "author": "Reza Salimi <rezasalimiofficiall@gmail.com>",
  "license": "MIT",
  "files": [
    "bin",
    "README.md",
    "docs"
  ],
  "dependencies": {
    "@electron/asar": "^4.2.0",
    "figlet": "^1.11.0",
    "ora": "^9.4.1",
    "picocolors": "^1.1.1",
    "prompts": "^2.4.2"
  },
  "type": "module",
  "bin": {
    "rz-antigravity-rtl": "bin/index.js",
    "antigravity-rtl": "bin/index.js"
  }
}
